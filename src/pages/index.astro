---
import Layout from '../layouts/Layout.astro';
import NationalStatsBar from '../components/NationalStatsBar.astro';
import GeoFinder from '../components/GeoFinder.astro';
import FaqSection from '../components/FaqSection.astro';
import nationalStats from '../data/national-stats.json';
import provincesSummary from '../data/provinces-summary.json';
import cheapestItaly from '../data/cheapest-italy.json';

// Raggruppa province per regione
const regionsMap = {};
for (const p of provincesSummary) {
  if (!regionsMap[p.region]) {
    regionsMap[p.region] = [];
  }
  regionsMap[p.region].push(p);
}
const sortedRegions = Object.keys(regionsMap).sort((a, b) => a.localeCompare(b, 'it'));

const topBenzina = (cheapestItaly.topBenzina || []).slice(0, 8);
const topDiesel = (cheapestItaly.topDiesel || []).slice(0, 8);
---

<Layout
  title="Prezzi Benzina e Diesel Oggi in Tempo Reale | PrezzoBenza.it"
  description="Trova il benzinaio più economico vicino a te. Prezzi aggiornati a oggi con dati ufficiali MIMIT per benzina, diesel, GPL e metano. Risparmia su ogni pieno!"
>
  <!-- Hero & Ticker Bar -->
  <NationalStatsBar />

  <!-- The Interactive Killer App -->
  <GeoFinder />

  <!-- Top 8 Più Economici d'Italia Section -->
  <section class="py-12 bg-zinc-900/30 border-y border-zinc-900">
    <div class="max-w-6xl mx-auto px-4 space-y-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
            🔥 Record Risparmio Oggi
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            I distributori più economici d'Italia
          </h2>
          <p class="text-xs sm:text-sm text-zinc-400">
            I prezzi più bassi registrati oggi nei distributori di rete ordinaria
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a
            href="/pompe-bianche"
            class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1 group"
          >
            <span>Vedi tutte le pompe bianche</span>
            <span class="group-hover:translate-x-0.5 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Tabbed Grid (Benzina vs Diesel) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Top Benzina -->
        <div class="space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-zinc-800">
            <span class="text-sm font-bold text-emerald-400 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              Top Benzina Self-Service
            </span>
            <span class="text-xs text-zinc-500 font-medium">Prezzo / Litro</span>
          </div>

          <div class="space-y-2.5">
            {topBenzina.map((st, i) => (
              <div class="p-3.5 rounded-xl border border-zinc-800/80 bg-zinc-950/70 hover:border-zinc-700 transition-colors flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="w-6 h-6 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-xs font-bold text-zinc-400 shrink-0">
                    {i + 1}
                  </span>
                  <div class="min-w-0">
                    <div class="text-xs font-bold text-white truncate">
                      {st.nome || st.brand}
                    </div>
                    <div class="text-[11px] text-zinc-400 truncate">
                      {st.comune} ({st.provincia}) — <span class="text-zinc-500">{st.brand}</span>
                    </div>
                  </div>
                </div>
                <div class="text-right shrink-0">
                  <div class="text-base font-black text-emerald-400">
                    € {st.prices.benzina_self?.prezzo?.toFixed(3)}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Top Diesel -->
        <div class="space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-zinc-800">
            <span class="text-sm font-bold text-teal-400 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-teal-400"></span>
              Top Diesel (Gasolio) Self-Service
            </span>
            <span class="text-xs text-zinc-500 font-medium">Prezzo / Litro</span>
          </div>

          <div class="space-y-2.5">
            {topDiesel.map((st, i) => (
              <div class="p-3.5 rounded-xl border border-zinc-800/80 bg-zinc-950/70 hover:border-zinc-700 transition-colors flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="w-6 h-6 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-xs font-bold text-zinc-400 shrink-0">
                    {i + 1}
                  </span>
                  <div class="min-w-0">
                    <div class="text-xs font-bold text-white truncate">
                      {st.nome || st.brand}
                    </div>
                    <div class="text-[11px] text-zinc-400 truncate">
                      {st.comune} ({st.provincia}) — <span class="text-zinc-500">{st.brand}</span>
                    </div>
                  </div>
                </div>
                <div class="text-right shrink-0">
                  <div class="text-base font-black text-teal-400">
                    € {st.prices.diesel_self?.prezzo?.toFixed(3)}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- All 107 Italian Provinces Directory (Programmatic SEO Powerhouse) -->
  <section id="province" class="py-16 max-w-6xl mx-auto px-4 space-y-10">
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-zinc-800 text-zinc-300">
        Navigazione Locale
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
        Prezzi Carburanti in tutte le <span class="text-emerald-400">107 Province Italiane</span>
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400">
        Consulta le medie, le pompe bianche e i distributori più economici comune per comune nella tua provincia.
      </p>
    </div>

    <!-- Regions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedRegions.map((regionName) => {
        const provs = regionsMap[regionName] || [];
        return (
          <div class="rounded-2xl border border-zinc-800/80 bg-zinc-900/40 p-5 space-y-3">
            <h3 class="font-bold text-white text-sm flex items-center justify-between pb-2 border-b border-zinc-800">
              <span>{regionName}</span>
              <span class="text-xs font-medium text-zinc-500">{provs.length} province</span>
            </h3>
            <ul class="grid grid-cols-2 gap-2 text-xs">
              {provs.map((p) => (
                <li>
                  <a
                    href={`/provincia/${p.slug}`}
                    class="block p-2 rounded-lg bg-zinc-950/60 border border-zinc-850 hover:border-emerald-500/40 hover:text-emerald-400 transition-all text-zinc-300"
                  >
                    <div class="font-semibold">{p.name}</div>
                    <div class="text-[10px] text-zinc-500 mt-0.5">
                      da {p.minBenzina ? `€ ${p.minBenzina.toFixed(3)}` : 'N/D'}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <!-- FAQ Section with Schema.org -->
  <FaqSection />
</Layout>
