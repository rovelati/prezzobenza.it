---
import Layout from '../layouts/Layout.astro';
import NationalStatsBar from '../components/NationalStatsBar.astro';
import GeoFinder from '../components/GeoFinder.astro';
import HallOfFameSalasso from '../components/HallOfFameSalasso.astro';
import ShareBar from '../components/ShareBar.astro';
import FaqSection from '../components/FaqSection.astro';
import nationalStats from '../data/national-stats.json';
import provincesSummary from '../data/provinces-summary.json';
import cheapestItaly from '../data/cheapest-italy.json';

// Raggruppa province per regione
const regionsMap = {};
for (const p of provincesSummary) {
  if (!regionsMap[p.region]) {
    regionsMap[p.region] = [];
  }
  regionsMap[p.region].push(p);
}
const sortedRegions = Object.keys(regionsMap).sort((a, b) => a.localeCompare(b, 'it'));

const topBenzina = (cheapestItaly.topBenzina || []).slice(0, 8);
const topDiesel = (cheapestItaly.topDiesel || []).slice(0, 8);

// Schema.org Structured Data with GeoCoordinates for top stations
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "PrezzoBenza.it",
      "url": "https://www.prezzobenza.it",
      "description": "Trova la benzina e il diesel più economici vicino a te con mappa interattiva e calcolo del costo reale di spostamento."
    },
    {
      "@type": "ItemList",
      "name": "I distributori di carburante più economici d'Italia",
      "itemListElement": topBenzina.map((st, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "item": {
          "@type": "GasStation",
          "name": st.nome || `${st.brand} ${st.comune}`,
          "address": {
            "@type": "PostalAddress",
            "streetAddress": st.indirizzo,
            "addressLocality": st.comune,
            "addressRegion": st.provincia,
            "addressCountry": "IT"
          },
          ...(st.lat && st.lng ? {
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": st.lat,
              "longitude": st.lng
            }
          } : {}),
          "hasMap": `https://www.google.com/maps/dir/?api=1&destination=${st.lat},${st.lng}`,
          "priceRange": `€ ${st.prices.benzina_self?.prezzo?.toFixed(3)}`,
          "currenciesAccepted": "EUR",
          "paymentAccepted": "Cash, Credit Card"
        }
      }))
    }
  ]
};
---

<Layout
  title="Prezzi Benzina e Diesel Oggi in Tempo Reale | PrezzoBenza.it"
  description="Trova il benzinaio più economico vicino a te con mappa e calcolo costo reale. Prezzi aggiornati MIMIT per benzina, diesel, GPL e metano. Risparmia subito!"
  structuredData={structuredData}
>
  <!-- Hero & Ticker Bar -->
  <NationalStatsBar />

  <!-- The Interactive Killer App with Map & Opportunity Cost -->
  <GeoFinder />

  <!-- Top 8 Più Economici d'Italia Section -->
  <section class="py-12 bg-zinc-100/60 dark:bg-zinc-900/30 border-y border-zinc-200 dark:border-zinc-900 transition-colors">
    <div class="max-w-6xl mx-auto px-4 space-y-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
            🔥 Record Risparmio Oggi
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-zinc-900 dark:text-white tracking-tight">
            I distributori più economici d'Italia
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
            I prezzi più bassi registrati oggi nei distributori di rete ordinaria
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a
            href="/pompe-bianche"
            class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 dark:hover:text-emerald-300 flex items-center gap-1 group"
          >
            <span>Vedi tutte le pompe bianche</span>
            <span class="group-hover:translate-x-0.5 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Tabbed Grid (Benzina vs Diesel) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Top Benzina -->
        <div class="space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-zinc-800">
            <span class="text-sm font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              Top Benzina Self-Service
            </span>
            <span class="text-xs text-zinc-400 dark:text-zinc-500 font-medium">Prezzo / Litro</span>
          </div>

          <div class="space-y-2.5">
            {topBenzina.map((st, i) => (
              <div class="p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-950/70 hover:border-zinc-300 dark:hover:border-zinc-700 shadow-sm transition-colors flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="w-6 h-6 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-xs font-bold text-zinc-600 dark:text-zinc-400 shrink-0">
                    {i + 1}
                  </span>
                  <div class="min-w-0">
                    <div class="text-xs font-bold text-zinc-900 dark:text-white truncate">
                      {st.nome || st.brand}
                    </div>
                    <div class="text-[11px] text-zinc-500 dark:text-zinc-400 truncate">
                      {st.comune} ({st.provincia}) — <span class="text-zinc-400 dark:text-zinc-500">{st.brand}</span>
                    </div>
                  </div>
                </div>
                <div class="text-right shrink-0">
                  <div class="text-base font-black text-emerald-600 dark:text-emerald-400">
                    € {st.prices.benzina_self?.prezzo?.toFixed(3)}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Top Diesel -->
        <div class="space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-zinc-200 dark:border-zinc-800">
            <span class="text-sm font-bold text-teal-600 dark:text-teal-400 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-teal-500"></span>
              Top Diesel (Gasolio) Self-Service
            </span>
            <span class="text-xs text-zinc-400 dark:text-zinc-500 font-medium">Prezzo / Litro</span>
          </div>

          <div class="space-y-2.5">
            {topDiesel.map((st, i) => (
              <div class="p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-950/70 hover:border-zinc-300 dark:hover:border-zinc-700 shadow-sm transition-colors flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="w-6 h-6 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-xs font-bold text-zinc-600 dark:text-zinc-400 shrink-0">
                    {i + 1}
                  </span>
                  <div class="min-w-0">
                    <div class="text-xs font-bold text-zinc-900 dark:text-white truncate">
                      {st.nome || st.brand}
                    </div>
                    <div class="text-[11px] text-zinc-500 dark:text-zinc-400 truncate">
                      {st.comune} ({st.provincia}) — <span class="text-zinc-400 dark:text-zinc-500">{st.brand}</span>
                    </div>
                  </div>
                </div>
                <div class="text-right shrink-0">
                  <div class="text-base font-black text-teal-600 dark:text-teal-400">
                    € {st.prices.diesel_self?.prezzo?.toFixed(3)}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Hall of Fame del Salasso (I più cari d'Italia) -->
  <HallOfFameSalasso />

  <!-- All 107 Italian Provinces Directory -->
  <section id="province" class="py-16 max-w-6xl mx-auto px-4 space-y-10">
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
        Navigazione Locale
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-zinc-900 dark:text-white tracking-tight">
        Prezzi Carburanti in tutte le <span class="text-emerald-500 dark:text-emerald-400">107 Province Italiane</span>
      </h2>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
        Consulta le medie, le pompe bianche e i distributori più economici comune per comune nella tua provincia.
      </p>
    </div>

    <!-- Regions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedRegions.map((regionName) => {
        const provs = regionsMap[regionName] || [];
        return (
          <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/40 p-5 space-y-3 shadow-sm transition-colors">
            <h3 class="font-bold text-zinc-900 dark:text-white text-sm flex items-center justify-between pb-2 border-b border-zinc-100 dark:border-zinc-800">
              <span>{regionName}</span>
              <span class="text-xs font-medium text-zinc-400 dark:text-zinc-500">{provs.length} province</span>
            </h3>
            <ul class="grid grid-cols-2 gap-2 text-xs">
              {provs.map((p) => (
                <li class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500/40 transition-all flex flex-col justify-between">
                  <a
                    href={`/provincia/${p.slug}/`}
                    class="font-bold text-zinc-800 dark:text-zinc-200 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors block truncate"
                    title={`Prezzi carburanti ${p.name}`}
                    onclick={`window.trackEvent && window.trackEvent('province_directory_click', { province: '${p.name.replace(/'/g, "\\'")}', target: 'province_page', fuel: 'all' })`}
                  >
                    {p.name}
                  </a>
                  <div class="flex items-center gap-1.5 mt-2 pt-1.5 border-t border-zinc-100 dark:border-zinc-800/80 text-[10px] flex-wrap">
                    <a
                      href={`/provincia/${p.slug}/`}
                      class="text-emerald-600 dark:text-emerald-400 hover:underline font-semibold"
                      title={`Prezzi Benzina ${p.name}`}
                      onclick={`window.trackEvent && window.trackEvent('province_directory_click', { province: '${p.name.replace(/'/g, "\\'")}', target: 'benzina', fuel: 'benzina' })`}
                    >
                      Benza {p.minBenzina ? `€${p.minBenzina.toFixed(2)}` : ''}
                    </a>
                    <span class="text-zinc-300 dark:text-zinc-700">•</span>
                    <a
                      href={`/provincia/${p.slug}/diesel/`}
                      class="text-teal-600 dark:text-teal-400 hover:underline font-semibold"
                      title={`Prezzi Diesel ${p.name}`}
                      onclick={`window.trackEvent && window.trackEvent('province_directory_click', { province: '${p.name.replace(/'/g, "\\'")}', target: 'diesel', fuel: 'diesel' })`}
                    >
                      Diesel {p.minDiesel ? `€${p.minDiesel.toFixed(2)}` : ''}
                    </a>
                    <span class="text-zinc-300 dark:text-zinc-700">•</span>
                    <a
                      href={`/provincia/${p.slug}/metano-gpl/`}
                      class="text-blue-600 dark:text-blue-400 hover:underline font-semibold"
                      title={`Prezzi GPL e Metano ${p.name}`}
                      onclick={`window.trackEvent && window.trackEvent('province_directory_click', { province: '${p.name.replace(/'/g, "\\'")}', target: 'metano_gpl', fuel: 'metano-gpl' })`}
                    >
                      Gas
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Share Bar for Social Viral Sharing -->
  <div class="max-w-6xl mx-auto px-4">
    <ShareBar />
  </div>

  <!-- FAQ Section with Schema.org -->
  <FaqSection />
</Layout>
