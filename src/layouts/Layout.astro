---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  structuredData?: any;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogType = 'website',
  structuredData,
} = Astro.props;

const siteUrl = 'https://www.prezzobenza.it';
const fullCanonical = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
---

<!doctype html>
<html lang="it" class="bg-zinc-950 text-zinc-100 antialiased selection:bg-emerald-500 selection:text-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="PrezzoBenza.it" />
    <meta property="og:locale" content="it_IT" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Mobile Theme -->
    <meta name="theme-color" content="#09090b" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "PrezzoBenza.it",
      "url": siteUrl,
      "description": "Trova il benzinaio più economico vicino a te. Prezzi carburanti aggiornati con dati ufficiali MIMIT.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${siteUrl}/provincia/{search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-zinc-950 text-zinc-100">
    <!-- Header -->
    <header class="sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-emerald-400 flex items-center justify-center text-zinc-950 shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 7h-1V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v18h10V11h1a2 2 0 0 0 2-2V7zm-9 6H8v-2h2v2zm0-4H8V7h2v2zm6 4h-2v-2h2v2zm0-4h-2V7h2v2zm4 4h-1V9h1v4zM5 19H3v-7a3 3 0 0 1 3-3v2a1 1 0 0 0-1 1v7z"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-black tracking-tight text-white">
              Prezzo<span class="text-emerald-400">Benza</span><span class="text-zinc-500 text-sm font-semibold">.it</span>
            </span>
            <span class="text-[10px] text-zinc-400 font-medium tracking-wide uppercase -mt-1">
              Il pieno intelligente
            </span>
          </div>
        </a>

        <!-- Nav -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
          <a href="/#trova-vicino" class="text-zinc-300 hover:text-emerald-400 transition-colors flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Vicino a Me
          </a>
          <a href="/#province" class="text-zinc-300 hover:text-emerald-400 transition-colors">
            Province
          </a>
          <a href="/pompe-bianche" class="text-zinc-300 hover:text-emerald-400 transition-colors">
            Pompe Bianche
          </a>
          <a href="/prezzi-oggi" class="text-zinc-300 hover:text-emerald-400 transition-colors">
            Prezzi Oggi
          </a>
        </nav>

        <!-- CTA Header -->
        <div class="flex items-center gap-2">
          <a
            href="/#trova-vicino"
            class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-emerald-500 hover:bg-emerald-400 text-zinc-950 transition-colors shadow-sm flex items-center gap-1.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
            </svg>
            <span>Trova Pompa</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-900 bg-zinc-950/80 text-zinc-400 text-xs py-12 mt-16">
      <div class="max-w-6xl mx-auto px-4 space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="space-y-3 md:col-span-1">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-lg bg-emerald-500 flex items-center justify-center text-zinc-950 font-bold text-sm">
                ⛽
              </div>
              <span class="text-base font-bold text-white">PrezzoBenza.it</span>
            </div>
            <p class="text-zinc-400 leading-relaxed">
              La guida indipendente e ultra-veloce per trovare la benzina, il diesel, il GPL e il metano al miglior prezzo d'Italia, vicino alla tua posizione attuale.
            </p>
          </div>

          <div>
            <h4 class="font-semibold text-zinc-200 mb-3 uppercase tracking-wider text-[11px]">Città Principali</h4>
            <ul class="space-y-1.5 text-zinc-400">
              <li><a href="/provincia/milano" class="hover:text-emerald-400 transition-colors">Prezzi Benzina Milano</a></li>
              <li><a href="/provincia/roma" class="hover:text-emerald-400 transition-colors">Prezzi Benzina Roma</a></li>
              <li><a href="/provincia/napoli" class="hover:text-emerald-400 transition-colors">Prezzi Benzina Napoli</a></li>
              <li><a href="/provincia/torino" class="hover:text-emerald-400 transition-colors">Prezzi Benzina Torino</a></li>
              <li><a href="/provincia/bologna" class="hover:text-emerald-400 transition-colors">Prezzi Benzina Bologna</a></li>
              <li><a href="/provincia/firenze" class="hover:text-emerald-400 transition-colors">Prezzi Benzina Firenze</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-zinc-200 mb-3 uppercase tracking-wider text-[11px]">Carburanti & Risparmio</h4>
            <ul class="space-y-1.5 text-zinc-400">
              <li><a href="/pompe-bianche" class="hover:text-emerald-400 transition-colors">Distributori Pompe Bianche</a></li>
              <li><a href="/prezzi-oggi" class="hover:text-emerald-400 transition-colors">Osservatorio Prezzi Oggi</a></li>
              <li><a href="/come-risparmiare" class="hover:text-emerald-400 transition-colors">Guida al Risparmio Carburante</a></li>
              <li><a href="/#faq" class="hover:text-emerald-400 transition-colors">Domande Frequenti (FAQ)</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-zinc-200 mb-3 uppercase tracking-wider text-[11px]">Fonte Dati & Trasparenza</h4>
            <p class="leading-relaxed text-zinc-500 text-[11px]">
              Dati ufficiali forniti dal <strong>Ministero delle Imprese e del Made in Italy (MIMIT)</strong> - Osservaprezzi Carburanti, comunicati quotidianamente dai gestori ai sensi dell'art. 51 legge 99/2009.
            </p>
            <div class="mt-3 text-emerald-400/90 font-medium text-[11px] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Aggiornamento automatico ogni 24h
            </div>
          </div>
        </div>

        <div class="pt-8 border-t border-zinc-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-zinc-600 text-[11px]">
          <div>
            © {new Date().getFullYear()} PrezzoBenza.it — Tutti i diritti riservati.
          </div>
          <div class="flex items-center gap-4">
            <a href="/privacy" class="hover:underline">Privacy Policy</a>
            <a href="/cookie" class="hover:underline">Cookie Policy</a>
            <a href="/#province" class="hover:underline">Mappa Province</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
