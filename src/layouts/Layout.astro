---
import '../styles/global.css';
import { lastUpdatedFull, lastUpdatedShort } from '../utils/date.js';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  structuredData?: any;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogType = 'website',
  ogImage = '/og-image.png',
  structuredData,
} = Astro.props;

const siteUrl = 'https://www.prezzobenza.it';
const fullCanonical = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`;
---

<!doctype html>
<html lang="it" class="dark scroll-smooth selection:bg-emerald-500 selection:text-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <meta name="google-adsense-account" content="ca-pub-2168172914069272" />

    <!-- Google tag (gtag.js) con Google Consent Mode v2 per CMP -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CWV48MMBDF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });
      gtag('js', new Date());

      gtag('config', 'G-CWV48MMBDF');

      window.trackEvent = function(eventName, eventParams) {
        try {
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, eventParams || {});
          }
        } catch (e) {
          console.debug('[GA4] Event error:', e);
        }
      };
    </script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="PrezzoBenza.it" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:secure_url" content={fullOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PrezzoBenza.it — Trova la benzina più economica vicino a te" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content="PrezzoBenza.it — Trova la benzina più economica vicino a te" />

    <!-- Mobile Theme -->
    <meta name="theme-color" content="#09090b" id="meta-theme-color" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Leaflet CSS & JS for Interactive Map (Vendored Locally + is:inline to prevent Astro stripping) -->
    <link rel="stylesheet" href="/leaflet/leaflet.css" />
    <script is:inline src="/leaflet/leaflet.js"></script>

    <!-- Theme Initializer & Global Toggle (prevents flash, guaranteed instant click) -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('pb_theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'light' || (!storedTheme && !prefersDark)) {
          document.documentElement.classList.remove('dark');
          const metaTheme = document.getElementById('meta-theme-color');
          if (metaTheme) metaTheme.setAttribute('content', '#f4f4f5');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();

      window.toggleTheme = function() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('pb_theme', isDark ? 'dark' : 'light');
        const metaTheme = document.getElementById('meta-theme-color');
        if (metaTheme) metaTheme.setAttribute('content', isDark ? '#09090b' : '#f4f4f5');

        // Dispatch custom event for Leaflet to switch tiles
        window.dispatchEvent(new CustomEvent('pb_theme_changed', { detail: { isDark } }));

        if (window.trackEvent) {
          window.trackEvent('theme_toggle', { theme: isDark ? 'dark' : 'light' });
        }
      };
    </script>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "PrezzoBenza.it",
      "url": siteUrl,
      "description": "Trova il benzinaio più economico vicino a te. Prezzi carburanti aggiornati con dati ufficiali MIMIT.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${siteUrl}/provincia/{search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- UniConsent CMP (Consent Management Platform) — Asincrono con fetchpriority="low" e dns-prefetch per tutelare FCP/LCP e performance -->
    <link rel="dns-prefetch" href="https://cmp.uniconsent.com" />
    <script is:inline async fetchpriority="low" src="https://cmp.uniconsent.com/v2/cmp.js" data-license="e538d9903a"></script>

    <!-- Google AdSense — Asincrono a bassa priorità di rete per proteggere FCP/LCP e armonizzato con Consent Mode -->
    <script
      is:inline
      async
      fetchpriority="low"
      crossorigin="anonymous"
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2168172914069272"
    ></script>
  </head>
  <body class="min-h-screen flex flex-col bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 transition-colors duration-200">
    <!-- Header -->
    <header class="sticky top-0 z-40 border-b border-zinc-200 dark:border-zinc-800/80 bg-white/90 dark:bg-zinc-950/90 backdrop-blur-md transition-colors duration-200">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-emerald-400 flex items-center justify-center text-zinc-950 shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 7h-1V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v18h10V11h1a2 2 0 0 0 2-2V7zm-9 6H8v-2h2v2zm0-4H8V7h2v2zm6 4h-2v-2h2v2zm0-4h-2V7h2v2zm4 4h-1V9h1v4zM5 19H3v-7a3 3 0 0 1 3-3v2a1 1 0 0 0-1 1v7z"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-black tracking-tight text-zinc-900 dark:text-white">
              Prezzo<span class="text-emerald-500 dark:text-emerald-400">Benza</span><span class="text-zinc-400 dark:text-zinc-500 text-sm font-semibold">.it</span>
            </span>
            <span class="text-[10px] text-zinc-500 dark:text-zinc-400 font-medium tracking-wide uppercase -mt-1">
              Il pieno intelligente
            </span>
          </div>
        </a>

        <!-- Nav -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
          <a href="/#trova-vicino" class="text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            Vicino a Me
          </a>
          <a href="/#province" class="text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
            Province
          </a>
          <a href="/pompe-bianche" class="text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
            Pompe Bianche
          </a>
          <a href="/prezzi-oggi" class="text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
            Prezzi Oggi
          </a>
          <a href="/come-risparmiare" class="text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
            Consigli
          </a>
        </nav>

        <!-- Live update date pill in header -->
        <div class="hidden xl:flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Aggiornato: {lastUpdatedShort}</span>
        </div>

        <!-- CTA & Theme Toggle -->
        <div class="flex items-center gap-2.5">
          <!-- Dark/Light Mode Button (Solar Mode Toggle) -->
          <button
            id="theme-toggle"
            type="button"
            onclick="window.toggleTheme()"
            aria-label="Cambia tema chiaro/scuro"
            title="Cambia tema chiaro (Solare) / scuro"
            class="p-2 rounded-xl text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/70 dark:hover:bg-zinc-800 border border-zinc-300 dark:border-zinc-800 transition-colors cursor-pointer"
          >
            <!-- Sun icon (shown in dark mode -> click to activate Solar mode) -->
            <svg id="sun-icon" class="w-4 h-4 hidden dark:block text-amber-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/>
            </svg>
            <!-- Moon icon (shown in light mode -> click to activate Dark mode) -->
            <svg id="moon-icon" class="w-4 h-4 block dark:hidden text-zinc-700" fill="currentColor" viewBox="0 0 20 20">
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
            </svg>
          </button>

          <a
            href="/#trova-vicino"
            class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-emerald-500 hover:bg-emerald-400 text-zinc-950 transition-colors shadow-sm flex items-center gap-1.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
            </svg>
            <span>Trova Pompa</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-200 dark:border-zinc-900 bg-white dark:bg-zinc-950/80 text-zinc-600 dark:text-zinc-400 text-xs py-12 mt-16 transition-colors duration-200">
      <div class="max-w-6xl mx-auto px-4 space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="space-y-3 md:col-span-1">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-lg bg-emerald-500 flex items-center justify-center text-zinc-950 font-bold text-sm">
                ⛽
              </div>
              <span class="text-base font-bold text-zinc-900 dark:text-white">PrezzoBenza.it</span>
            </div>
            <p class="text-zinc-500 dark:text-zinc-400 leading-relaxed text-xs">
              La guida indipendente e ultra-veloce per trovare la benzina, il diesel, il GPL e il metano al miglior prezzo d'Italia, vicino alla tua posizione attuale calcolando il costo reale dello spostamento.
            </p>
          </div>

          <div>
            <h4 class="font-semibold text-zinc-900 dark:text-zinc-200 mb-3 uppercase tracking-wider text-[11px]">Città Principali</h4>
            <ul class="space-y-1.5 text-zinc-600 dark:text-zinc-400 text-xs">
              <li>
                <a href="/provincia/milano/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-medium">Milano</a>
                <span class="text-zinc-400 text-[10px] ml-1">(<a href="/provincia/milano/" class="hover:underline">Benza</a> • <a href="/provincia/milano/diesel/" class="hover:underline text-teal-600 dark:text-teal-400">Diesel</a>)</span>
              </li>
              <li>
                <a href="/provincia/roma/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-medium">Roma</a>
                <span class="text-zinc-400 text-[10px] ml-1">(<a href="/provincia/roma/" class="hover:underline">Benza</a> • <a href="/provincia/roma/diesel/" class="hover:underline text-teal-600 dark:text-teal-400">Diesel</a>)</span>
              </li>
              <li>
                <a href="/provincia/napoli/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-medium">Napoli</a>
                <span class="text-zinc-400 text-[10px] ml-1">(<a href="/provincia/napoli/" class="hover:underline">Benza</a> • <a href="/provincia/napoli/diesel/" class="hover:underline text-teal-600 dark:text-teal-400">Diesel</a>)</span>
              </li>
              <li>
                <a href="/provincia/torino/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-medium">Torino</a>
                <span class="text-zinc-400 text-[10px] ml-1">(<a href="/provincia/torino/" class="hover:underline">Benza</a> • <a href="/provincia/torino/diesel/" class="hover:underline text-teal-600 dark:text-teal-400">Diesel</a>)</span>
              </li>
              <li>
                <a href="/provincia/bologna/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-medium">Bologna</a>
                <span class="text-zinc-400 text-[10px] ml-1">(<a href="/provincia/bologna/" class="hover:underline">Benza</a> • <a href="/provincia/bologna/diesel/" class="hover:underline text-teal-600 dark:text-teal-400">Diesel</a>)</span>
              </li>
              <li>
                <a href="/provincia/firenze/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-medium">Firenze</a>
                <span class="text-zinc-400 text-[10px] ml-1">(<a href="/provincia/firenze/" class="hover:underline">Benza</a> • <a href="/provincia/firenze/diesel/" class="hover:underline text-teal-600 dark:text-teal-400">Diesel</a>)</span>
              </li>
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-zinc-900 dark:text-zinc-200 mb-3 uppercase tracking-wider text-[11px]">Carburanti & Risparmio</h4>
            <ul class="space-y-1.5 text-zinc-600 dark:text-zinc-400">
              <li><a href="/pompe-bianche" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Distributori Pompe Bianche</a></li>
              <li><a href="/prezzi-oggi" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Osservatorio Prezzi Oggi</a></li>
              <li><a href="/come-risparmiare" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Guida al Risparmio Carburante</a></li>
              <li><a href="/#faq" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Domande Frequenti (FAQ)</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-zinc-900 dark:text-zinc-200 mb-3 uppercase tracking-wider text-[11px]">Fonte Dati & Trasparenza</h4>
            <p class="leading-relaxed text-zinc-500 text-[11px]">
              Dati ufficiali forniti dal <strong>Ministero delle Imprese e del Made in Italy (MIMIT)</strong> - Osservaprezzi Carburanti, comunicati quotidianamente dai gestori ai sensi dell'art. 51 legge 99/2009.
            </p>
            <div class="mt-3 text-emerald-600 dark:text-emerald-400 font-medium text-[11px] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>Ultimo aggiornamento MIMIT: <strong>{lastUpdatedFull}</strong></span>
            </div>
          </div>
        </div>

        <div class="pt-8 border-t border-zinc-200 dark:border-zinc-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-zinc-500 dark:text-zinc-600 text-[11px]">
          <div>
            © {new Date().getFullYear()} PrezzoBenza.it — Tutti i diritti riservati.
          </div>
          <div class="flex items-center gap-4">
            <a href="/privacy" class="hover:underline">Privacy Policy</a>
            <a href="/cookie" class="hover:underline">Cookie Policy</a>
            <a href="/#province" class="hover:underline">Mappa Province</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
