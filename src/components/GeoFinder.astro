---
import nationalStats from '../data/national-stats.json';
import provincesSummary from '../data/provinces-summary.json';
import cheapestItaly from '../data/cheapest-italy.json';
import { lastUpdatedShort } from '../utils/date.js';

const provincesCentroids = provincesSummary.map(p => ({
  code: p.code,
  name: p.name,
  slug: p.slug,
  lat: p.lat,
  lng: p.lng,
  avgBenzina: p.avgBenzina,
  avgDiesel: p.avgDiesel,
}));

const initialCheapestStations = (cheapestItaly.topBenzina || []).slice(0, 10).map(st => ({
  id: st.id,
  nome: st.nome,
  brand: st.brand,
  indirizzo: st.indirizzo,
  comune: st.comune,
  provincia: st.provincia,
  lat: st.lat,
  lng: st.lng,
  tipo: st.tipo,
  prices: st.prices,
}));
---

<section id="trova-vicino" class="relative py-10 md:py-14 overflow-hidden">
  <!-- Glow effect background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-emerald-500/10 dark:bg-emerald-500/10 blur-[120px] pointer-events-none rounded-full"></div>

  <div class="max-w-4xl mx-auto px-4 relative z-10 space-y-6">
    <!-- Main Card -->
    <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-900/90 shadow-2xl backdrop-blur-xl p-5 sm:p-7 md:p-8 space-y-6 transition-colors flex flex-col">
      
      <!-- Badges: Dati MIMIT e IP (in fondo su mobile, in alto su desktop) -->
      <div id="badges-container" class="order-last md:order-first pt-3 md:pt-0 flex flex-wrap items-center justify-center gap-2 border-t md:border-t-0 border-zinc-100 dark:border-zinc-800/60">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-center">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Dati MIMIT Ufficiali • Aggiornato al {lastUpdatedShort} • Algoritmo Prezzo Opportunità
        </div>
        <div id="ip-location-pill" class="hidden inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/25 transition-all">
          <span class="w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span>
          <span id="ip-location-text">📍 Posizione rilevata da IP...</span>
        </div>
      </div>

      <!-- Card Header -->
      <div class="text-center space-y-2 order-1 md:order-none">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-zinc-900 dark:text-white">
          Trova la benza più economica <span class="text-emerald-500 dark:text-emerald-400">vicino a te</span>
        </h2>
        <p class="text-xs sm:text-sm md:text-base text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
          Calcola il <strong>costo reale</strong> tenendo conto dei litri e del tempo consumati per raggiungere il distributore.
        </p>
      </div>

      <!-- Controls Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 pt-1">
        
        <!-- Carburante Selector -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
            Tipo Carburante
          </label>
          <div class="grid grid-cols-2 gap-1.5 p-1 bg-zinc-100 dark:bg-zinc-950 rounded-xl border border-zinc-200 dark:border-zinc-800" id="fuel-selector">
            <button
              type="button"
              data-fuel="benzina"
              class="fuel-btn active px-3 py-2 text-xs font-bold rounded-lg transition-all bg-emerald-500 text-zinc-950 shadow-sm"
            >
              🟢 Benzina
            </button>
            <button
              type="button"
              data-fuel="diesel"
              class="fuel-btn px-3 py-2 text-xs font-bold rounded-lg transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200"
            >
              ⚫ Diesel
            </button>
            <button
              type="button"
              data-fuel="gpl"
              class="fuel-btn px-3 py-2 text-xs font-bold rounded-lg transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200"
            >
              🔵 GPL
            </button>
            <button
              type="button"
              data-fuel="metano"
              class="fuel-btn px-3 py-2 text-xs font-bold rounded-lg transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200"
            >
              ⚪ Metano
            </button>
          </div>
        </div>

        <!-- Servizio Selector -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
            Modalità
          </label>
          <div class="grid grid-cols-2 gap-1.5 p-1 bg-zinc-100 dark:bg-zinc-950 rounded-xl border border-zinc-200 dark:border-zinc-800" id="service-selector">
            <button
              type="button"
              data-service="self"
              class="service-btn active px-3 py-3.5 text-xs font-bold rounded-lg transition-all bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-sm"
            >
              Self-Service
            </button>
            <button
              type="button"
              data-service="servito"
              class="service-btn px-3 py-3.5 text-xs font-bold rounded-lg transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200"
            >
              Servito
            </button>
          </div>
        </div>

        <!-- Raggio Selector -->
        <div class="sm:col-span-2 md:col-span-1">
          <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
            Raggio di Ricerca
          </label>
          <div class="grid grid-cols-4 gap-1 p-1 bg-zinc-100 dark:bg-zinc-950 rounded-xl border border-zinc-200 dark:border-zinc-800" id="radius-selector">
            <button
              type="button"
              data-radius="1.5"
              class="radius-btn px-1.5 py-3.5 text-xs font-bold rounded-lg transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200"
            >
              1,5 km
            </button>
            <button
              type="button"
              data-radius="5"
              class="radius-btn px-1.5 py-3.5 text-xs font-bold rounded-lg transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200"
            >
              5 km
            </button>
            <button
              type="button"
              data-radius="10"
              class="radius-btn active px-1.5 py-3.5 text-xs font-bold rounded-lg transition-all bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-sm"
            >
              10 km
            </button>
            <button
              type="button"
              data-radius="25"
              class="radius-btn px-1.5 py-3.5 text-xs font-bold rounded-lg transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200"
            >
              25 km
            </button>
          </div>
        </div>

      </div>

      <!-- Parametri Prezzo Opportunità (Accordion Rapido) -->
      <details class="group rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/80 dark:bg-zinc-950/40 p-4 transition-all">
        <summary class="flex items-center justify-between cursor-pointer list-none text-xs font-bold text-zinc-700 dark:text-zinc-300">
          <div class="flex items-center gap-2">
            <span>⚙️ Calcolo Costo Spostamento & Pieno</span>
            <span class="px-2 py-0.5 rounded text-[10px] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold" id="opportunity-summary-badge">
              50 Litri • 6.5 L/100km
            </span>
          </div>
          <span class="text-zinc-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 mt-2 border-t border-zinc-200 dark:border-zinc-800 text-xs">
          <div>
            <label class="block font-semibold text-zinc-600 dark:text-zinc-400 mb-1">
              Litri di Rifornimento: <span id="liters-val" class="text-emerald-600 dark:text-emerald-400 font-black">50 L</span>
            </label>
            <input
              id="liters-range"
              type="range"
              min="15"
              max="90"
              step="5"
              value="50"
              class="w-full accent-emerald-500 cursor-pointer"
            />
            <div class="flex justify-between text-[10px] text-zinc-400 mt-1">
              <span>15 L (Scooter)</span>
              <span>50 L (Utilitaria)</span>
              <span>90 L (SUV/Furgone)</span>
            </div>
          </div>

          <div>
            <label class="block font-semibold text-zinc-600 dark:text-zinc-400 mb-1">
              Consumo Medio Auto: <span id="consumption-val" class="text-emerald-600 dark:text-emerald-400 font-black">6.5 L / 100 km</span>
            </label>
            <input
              id="consumption-range"
              type="range"
              min="4.0"
              max="12.0"
              step="0.5"
              value="6.5"
              class="w-full accent-emerald-500 cursor-pointer"
            />
            <div class="flex justify-between text-[10px] text-zinc-400 mt-1">
              <span>4.0 (Ibrida)</span>
              <span>6.5 (Media)</span>
              <span>12.0 (Benzina sportiva)</span>
            </div>
          </div>
        </div>
      </details>

      <!-- Action Button (GPS One-Tap) -->
      <div class="pt-1">
        <button
          id="btn-geolocate"
          type="button"
          class="w-full relative group overflow-hidden py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-500 via-emerald-400 to-teal-400 text-zinc-950 font-black text-base sm:text-lg shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-3 cursor-pointer"
        >
          <div class="w-8 h-8 rounded-full bg-zinc-950/20 flex items-center justify-center text-zinc-950 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
            </svg>
          </div>
          <span id="btn-text">📍 Vicino a Te</span>
          <span id="spinner" class="hidden w-5 h-5 border-2 border-zinc-950 border-t-transparent rounded-full animate-spin"></span>
        </button>
      </div>

      <!-- Manual Province Search Fallback -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-zinc-200 dark:border-zinc-800 text-xs text-zinc-500 dark:text-zinc-400">
        <span>Oppure cerca direttamente per provincia:</span>
        <div class="w-full sm:w-64">
          <select
            id="province-select"
            class="w-full bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 rounded-xl px-3 py-2 text-zinc-800 dark:text-zinc-200 text-xs focus:outline-none focus:border-emerald-500 transition-colors"
          >
            <option value="">-- Seleziona una provincia --</option>
            {provincesSummary.map((p) => (
              <option value={p.code}>
                {p.name} ({p.code}) — da {p.minBenzina ? `€ ${p.minBenzina.toFixed(3)}` : 'N/D'}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Status / Alerts Box -->
      <div id="status-box" class="hidden p-4 rounded-xl text-xs font-medium"></div>

      <!-- Interactive Map & Live Results Container (Always Visible) -->
      <div id="results-container" class="space-y-5 pt-4">
        
        <!-- Results Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-zinc-200 dark:border-zinc-800">
          <div class="space-y-0.5">
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white flex items-center gap-2">
              <span>Mappa Distributori in Tempo Reale</span>
              <span id="results-count" class="px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-600 dark:text-emerald-400">15</span>
            </h3>
            <p id="results-subtitle" class="text-xs text-zinc-500 dark:text-zinc-400">
              I distributori con il miglior prezzo in Italia. Usa il pulsante GPS o seleziona una provincia per calcolare il risparmio vicino a te.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <span class="text-zinc-500">Ordina:</span>
            <button id="sort-price" class="px-2.5 py-1 rounded-lg bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-white font-semibold">Prezzo</button>
            <button id="sort-opportunity" class="px-2.5 py-1 rounded-lg text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">Risparmio Netto</button>
            <button id="sort-distance" class="px-2.5 py-1 rounded-lg text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">Distanza</button>
          </div>
        </div>

        <!-- The Interactive Map -->
        <div class="relative overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-lg bg-zinc-100 dark:bg-zinc-950">
          <div id="map" class="w-full h-[380px] rounded-2xl" style="min-height: 380px; width: 100%; z-index: 10;"></div>
          <div class="absolute bottom-2 left-2 z-[400] bg-zinc-900/80 backdrop-blur-md text-[10px] text-zinc-300 px-2 py-1 rounded border border-zinc-700 pointer-events-none">
            🟢 Verde = Più Economico • 📍 Clicca un pin per dettagli e Google Maps
          </div>
        </div>

        <!-- Cards List -->
        <div id="stations-list" class="space-y-3 pt-2"></div>
      </div>

    </div>
  </div>
</section>

<!-- Data for Client script -->
<script define:vars={{ provincesCentroids, nationalStats, initialCheapestStations }}>
  window.__PB_PROVINCES = provincesCentroids;
  window.__PB_STATS = nationalStats;
  window.__PB_INITIAL_STATIONS = initialCheapestStations;
</script>

<script>
  // Client Logic
  let selectedFuel = 'benzina';
  let selectedService = 'self';
  let selectedRadius = 10;
  let currentStations = [];
  let userCoords = null;
  let currentSort = 'price';
  let hasSearched = false;

  // Parametri Prezzo Opportunità
  let userLiters = 50;
  let userConsumptionPer100 = 6.5;

  let leafletMap = null;
  let tileLayer = null;
  let markersLayer = null;

  const btnGeolocate = document.getElementById('btn-geolocate');
  const btnText = document.getElementById('btn-text');
  const spinner = document.getElementById('spinner');
  const statusBox = document.getElementById('status-box');
  const resultsContainer = document.getElementById('results-container');
  const resultsCount = document.getElementById('results-count');
  const resultsSubtitle = document.getElementById('results-subtitle');
  const stationsList = document.getElementById('stations-list');
  const provinceSelect = document.getElementById('province-select');

  const litersRange = document.getElementById('liters-range');
  const litersVal = document.getElementById('liters-val');
  const consumptionRange = document.getElementById('consumption-range');
  const consumptionVal = document.getElementById('consumption-val');
  const opportunityBadge = document.getElementById('opportunity-summary-badge');

  const sortPriceBtn = document.getElementById('sort-price');
  const sortOpportunityBtn = document.getElementById('sort-opportunity');
  const sortDistanceBtn = document.getElementById('sort-distance');

  // Sliders
  litersRange?.addEventListener('input', (e) => {
    userLiters = Number(e.target.value);
    litersVal.textContent = `${userLiters} L`;
    updateOpportunityBadge();
    if (currentStations.length > 0) renderResults();
  });

  consumptionRange?.addEventListener('input', (e) => {
    userConsumptionPer100 = Number(e.target.value);
    consumptionVal.textContent = `${userConsumptionPer100.toFixed(1)} L / 100 km`;
    updateOpportunityBadge();
    if (currentStations.length > 0) renderResults();
  });

  function updateOpportunityBadge() {
    if (opportunityBadge) {
      opportunityBadge.textContent = `${userLiters} Litri • ${userConsumptionPer100.toFixed(1)} L/100km`;
    }
  }

  // Fuel selector click
  document.querySelectorAll('.fuel-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fuel-btn').forEach(b => {
        b.classList.remove('active', 'bg-emerald-500', 'text-zinc-950');
        b.classList.add('text-zinc-600', 'dark:text-zinc-400');
      });
      btn.classList.add('active', 'bg-emerald-500', 'text-zinc-950');
      btn.classList.remove('text-zinc-600', 'dark:text-zinc-400');
      selectedFuel = btn.dataset.fuel;
      if (currentStations.length > 0) renderResults();
    });
  });

  // Service selector click
  document.querySelectorAll('.service-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.service-btn').forEach(b => {
        b.classList.remove('active', 'bg-white', 'dark:bg-zinc-800', 'text-zinc-900', 'dark:text-white');
        b.classList.add('text-zinc-600', 'dark:text-zinc-400');
      });
      btn.classList.add('active', 'bg-white', 'dark:bg-zinc-800', 'text-zinc-900', 'dark:text-white');
      btn.classList.remove('text-zinc-600', 'dark:text-zinc-400');
      selectedService = btn.dataset.service;
      if (currentStations.length > 0) renderResults();
    });
  });

  function setRadius(radius) {
    selectedRadius = Number(radius);
    document.querySelectorAll('.radius-btn').forEach(b => {
      if (Number(b.dataset.radius) === selectedRadius) {
        b.classList.add('active', 'bg-white', 'dark:bg-zinc-800', 'text-zinc-900', 'dark:text-white', 'shadow-sm');
        b.classList.remove('text-zinc-600', 'dark:text-zinc-400');
      } else {
        b.classList.remove('active', 'bg-white', 'dark:bg-zinc-800', 'text-zinc-900', 'dark:text-white', 'shadow-sm');
        b.classList.add('text-zinc-600', 'dark:text-zinc-400');
      }
    });
  }

  // Radius selector click
  document.querySelectorAll('.radius-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      setRadius(btn.dataset.radius);
      if (userCoords && currentStations.length > 0) renderResults();
    });
  });

  // Sort buttons
  sortPriceBtn?.addEventListener('click', () => {
    currentSort = 'price';
    updateSortButtons();
    renderResults();
  });

  sortOpportunityBtn?.addEventListener('click', () => {
    currentSort = 'opportunity';
    updateSortButtons();
    renderResults();
  });

  sortDistanceBtn?.addEventListener('click', () => {
    currentSort = 'distance';
    updateSortButtons();
    renderResults();
  });

  function updateSortButtons() {
    const activeClass = 'px-2.5 py-1 rounded-lg bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-white font-semibold';
    const inactiveClass = 'px-2.5 py-1 rounded-lg text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white';
    
    sortPriceBtn.className = currentSort === 'price' ? activeClass : inactiveClass;
    sortOpportunityBtn.className = currentSort === 'opportunity' ? activeClass : inactiveClass;
    sortDistanceBtn.className = currentSort === 'distance' ? activeClass : inactiveClass;
  }

  // Province select change
  provinceSelect?.addEventListener('change', async (e) => {
    const code = e.target.value;
    if (!code) return;
    hasSearched = true;
    await loadProvinceStations(code);
  });

  // Haversine formula
  function getDistanceKm(lat1, lon1, lat2, lon2) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a =
      Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
      Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  // Leaflet Map Initialization (100% Free OpenStreetMap - ZERO API Keys & No Watermark)
  function initOrUpdateMap(centerLat, centerLng, zoom = 12) {
    if (typeof window.L === 'undefined') return;

    const osmTiles = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';

    if (!leafletMap) {
      leafletMap = window.L.map('map', {
        zoomControl: true,
        scrollWheelZoom: false,
      }).setView([centerLat, centerLng], zoom);

      tileLayer = window.L.tileLayer(osmTiles, {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
        maxZoom: 19,
      }).addTo(leafletMap);

      markersLayer = window.L.layerGroup().addTo(leafletMap);
    } else {
      leafletMap.flyTo([centerLat, centerLng], zoom, { duration: 1.0 });
      setTimeout(() => { leafletMap.invalidateSize(); }, 200);
    }
  }

  // Geolocation trigger
  btnGeolocate?.addEventListener('click', () => {
    hasSearched = true;
    if (!navigator.geolocation) {
      showStatus('La geolocalizzazione GPS non è supportata dal tuo browser. Seleziona una provincia dal menu.', 'error');
      return;
    }

    setLoading(true);
    showStatus('Rilevamento posizione GPS ad alta precisione in corso...', 'info');

    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        userCoords = {
          lat: pos.coords.latitude,
          lng: pos.coords.longitude,
          isIp: false,
          cityName: null,
        };

        const sortedProvs = [...window.__PB_PROVINCES]
          .filter(p => p.lat && p.lng)
          .map(p => ({
            ...p,
            distance: getDistanceKm(userCoords.lat, userCoords.lng, p.lat, p.lng),
          }))
          .sort((a, b) => a.distance - b.distance);

        const nearestProvs = sortedProvs.slice(0, 2);
        showStatus(`Posizione GPS rilevata! Caricamento distributori (${nearestProvs[0].name})...`, 'info');

        try {
          const stationPromises = nearestProvs.map(p =>
            fetch(`/data/provinces/${p.code.toLowerCase()}.json`).then(r => r.json())
          );
          const results = await Promise.all(stationPromises);
          
          let combined = [];
          for (const res of results) {
            combined = combined.concat(res.stations || []);
          }

          currentStations = combined
            .filter(s => s.lat && s.lng)
            .map(s => ({
              ...s,
              distanceKm: Number(getDistanceKm(userCoords.lat, userCoords.lng, s.lat, s.lng).toFixed(1)),
            }));

          // Se siamo in un centro urbano con buona densità (es. Milano, Roma, Torino dove ci sono distributori entro 1.5km),
          // impostiamo automaticamente il raggio su 1.5 km (o 5 km) per evitare di consigliare pompe lontane nel traffico
          const targetKey = getTargetPriceKey();
          const in1_5km = currentStations.filter(s => s.prices && s.prices[targetKey] && s.distanceKm <= 1.5);
          const in5km = currentStations.filter(s => s.prices && s.prices[targetKey] && s.distanceKm <= 5);

          if (in1_5km.length >= 2) {
            setRadius(1.5);
          } else if (in5km.length >= 2) {
            setRadius(5);
          } else {
            setRadius(10);
          }

          setLoading(false);
          statusBox.classList.add('hidden');
          if (btnText) btnText.textContent = '✅ Posizione GPS Esatta Attiva';

          const ipBadge = document.getElementById('ip-location-pill');
          const ipText = document.getElementById('ip-location-text');
          if (ipBadge && ipText) {
            ipBadge.className = 'inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
            ipText.innerHTML = `🎯 <strong>Posizione GPS Esatta Attiva</strong>`;
            ipBadge.classList.remove('hidden');
          }

          renderResults();
        } catch (err) {
          console.error(err);
          setLoading(false);
          showStatus('Errore nel recupero dei dati della tua zona. Riprova o scegli la provincia.', 'error');
        }
      },
      (err) => {
        setLoading(false);
        let msg = 'Permesso GPS non concesso. Puoi comunque usare la geolocalizzazione da IP o scegliere la provincia.';
        if (err.code === 2) msg = 'Posizione GPS non disponibile. Usando la stima da IP.';
        if (err.code === 3) msg = 'Timeout GPS. Seleziona la provincia dal menu o usa la stima IP.';
        showStatus(msg, 'error');
      },
      { timeout: 10000, enableHighAccuracy: true }
    );
  });

  // Fetch IP Location from Cloudflare Functions or fast edge fallback
  async function fetchIpLocation() {
    // 1. Cloudflare Pages Function (/api/geo)
    try {
      const res = await fetch('/api/geo', { signal: AbortSignal.timeout(2000) });
      if (res.ok) {
        const data = await res.json();
        if (data && data.latitude && data.longitude) {
          return {
            lat: Number(data.latitude),
            lng: Number(data.longitude),
            city: data.city || data.region || 'La tua zona',
          };
        }
      }
    } catch (e) {}

    // 2. GeoJS (Free, fast edge CDN, CORS enabled)
    try {
      const res = await fetch('https://get.geojs.io/v1/ip/geo.json', { signal: AbortSignal.timeout(2500) });
      if (res.ok) {
        const data = await res.json();
        if (data && data.latitude && data.longitude) {
          return {
            lat: parseFloat(data.latitude),
            lng: parseFloat(data.longitude),
            city: data.city || data.region || 'La tua zona',
          };
        }
      }
    } catch (e) {}

    // 3. ipwho.is fallback
    try {
      const res = await fetch('https://ipwho.is/', { signal: AbortSignal.timeout(2500) });
      if (res.ok) {
        const data = await res.json();
        if (data && data.success && data.latitude && data.longitude) {
          return {
            lat: Number(data.latitude),
            lng: Number(data.longitude),
            city: data.city || data.region || 'La tua zona',
          };
        }
      }
    } catch (e) {}

    return null;
  }

  // Automatic IP Geolocation on Page Load
  async function autoGeolocateByIp() {
    try {
      const geo = await fetchIpLocation();
      if (!geo || !geo.lat || !geo.lng) return;

      // Se l'utente ha già attivato manualmente il GPS, non sovrascrivere
      if (userCoords && !userCoords.isIp) return;

      userCoords = {
        lat: geo.lat,
        lng: geo.lng,
        isIp: true,
        cityName: geo.city,
      };

      // Trova le province più vicine alle coordinate dell'IP
      const sortedProvs = [...window.__PB_PROVINCES]
        .filter(p => p.lat && p.lng)
        .map(p => ({
          ...p,
          distance: getDistanceKm(userCoords.lat, userCoords.lng, p.lat, p.lng),
        }))
        .sort((a, b) => a.distance - b.distance);

      const nearestProvs = sortedProvs.slice(0, 2);
      if (nearestProvs.length === 0) return;

      if (provinceSelect) {
        provinceSelect.value = nearestProvs[0].code;
      }

      const stationPromises = nearestProvs.map(p =>
        fetch(`/data/provinces/${p.code.toLowerCase()}.json`).then(r => r.json())
      );
      const results = await Promise.all(stationPromises);

      let combined = [];
      for (const res of results) {
        combined = combined.concat(res.stations || []);
      }

      currentStations = combined
        .filter(s => s.lat && s.lng)
        .map(s => ({
          ...s,
          distanceKm: Number(getDistanceKm(userCoords.lat, userCoords.lng, s.lat, s.lng).toFixed(1)),
        }));

      // Aggiorna Badge IP
      const ipBadge = document.getElementById('ip-location-pill');
      const ipText = document.getElementById('ip-location-text');
      if (ipBadge && ipText) {
        ipText.innerHTML = `📍 Rilevato da IP: <strong class="text-sky-700 dark:text-sky-300">${geo.city}</strong> (${nearestProvs[0].name})`;
        ipBadge.classList.remove('hidden');
      }

      // Aggiorna testo pulsante CTA
      if (btnText && (!userCoords || userCoords.isIp)) {
        btnText.textContent = `📍 Vicino a Te (${geo.city})`;
      }

      renderResults();
    } catch (err) {
      console.warn('Auto-geolocalizzazione IP non riuscita, mantengo vista nazionale:', err);
    }
  }

  async function loadProvinceStations(code) {
    setLoading(true);
    showStatus(`Caricamento distributori per la provincia ${code}...`, 'info');
    try {
      const res = await fetch(`/data/provinces/${code.toLowerCase()}.json`);
      const data = await res.json();
      currentStations = (data.stations || []).map(s => ({
        ...s,
        distanceKm: null,
      }));
      userCoords = null;
      setLoading(false);
      statusBox.classList.add('hidden');
      renderResults(data.name);
    } catch (err) {
      setLoading(false);
      showStatus('Impossibile caricare i dati della provincia. Riprova.', 'error');
    }
  }

  function getTargetPriceKey() {
    if (selectedFuel === 'benzina') return selectedService === 'self' ? 'benzina_self' : 'benzina_servito';
    if (selectedFuel === 'diesel') return selectedService === 'self' ? 'diesel_self' : 'diesel_servito';
    if (selectedFuel === 'gpl') return 'gpl';
    if (selectedFuel === 'metano') return 'metano';
    return 'benzina_self';
  }

  // Prezzo Opportunità: calcolo costi spostamento e convenienza reale
  function calculateOpportunity(st, priceVal, natAvg) {
    if (!userCoords || st.distanceKm === null) {
      return {
        hasGeo: false,
        tripCost: 0,
        tripMinutes: 0,
        netSavings: 0,
        isWorthIt: true,
        verdict: 'Visualizzazione per provincia',
      };
    }

    const distOneWay = st.distanceKm;
    const distRoundTrip = distOneWay * 2; // Andata e ritorno
    const litersBurned = distRoundTrip * (userConsumptionPer100 / 100);
    const tripCost = Number((litersBurned * priceVal).toFixed(2));
    
    // Stima tempo: velocità media urbana/extraurbana 35 km/h + 2 min sosta
    const tripMinutes = Math.round((distRoundTrip / 35) * 60);

    // Risparmio lordo rispetto alla media nazionale sul quantitativo di litri scelto
    const grossSavings = natAvg ? (natAvg - priceVal) * userLiters : 0;
    const netSavings = Number((grossSavings - tripCost).toFixed(2));

    let verdict = '';
    let badgeClass = '';
    let isWorthIt = false;

    if (netSavings >= 1.00) {
      isWorthIt = true;
      verdict = `✅ Conviene! Risparmi € ${netSavings.toFixed(2)} netti (già tolta la benza per andarci)`;
      badgeClass = 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
    } else if (netSavings > 0) {
      isWorthIt = true;
      verdict = `⚠️ Marginale: risparmi solo € ${netSavings.toFixed(2)} netti per ${tripMinutes} min di viaggio A/R`;
      badgeClass = 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20';
    } else {
      isWorthIt = false;
      const loss = Math.abs(netSavings).toFixed(2);
      verdict = `❌ Non conviene: consumi € ${tripCost.toFixed(2)} di viaggio e perdi € ${loss} sul pieno!`;
      badgeClass = 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20';
    }

    return {
      hasGeo: true,
      tripCost,
      tripMinutes,
      netSavings,
      isWorthIt,
      verdict,
      badgeClass,
    };
  }

  function renderResults(provName = '') {
    const priceKey = getTargetPriceKey();
    const natAvg = window.__PB_STATS?.averages?.[priceKey] || null;

    let filtered = currentStations.filter(s => s.prices && s.prices[priceKey]);

    if (userCoords) {
      filtered = filtered.filter(s => s.distanceKm <= selectedRadius);
      // Auto-espandi se non si trovano pompe nel raggio (es. zona rurale o IP)
      if (filtered.length === 0) {
        if (selectedRadius === 1.5) {
          setRadius(5);
          filtered = currentStations.filter(s => s.prices && s.prices[priceKey] && s.distanceKm <= 5);
        } else if (selectedRadius === 5 && userCoords.isIp) {
          setRadius(10);
          filtered = currentStations.filter(s => s.prices && s.prices[priceKey] && s.distanceKm <= 10);
        } else if (selectedRadius === 10 && userCoords.isIp) {
          setRadius(25);
          filtered = currentStations.filter(s => s.prices && s.prices[priceKey] && s.distanceKm <= 25);
        }
      }
    }

    // Aggiungi calcolo opportunità ad ogni stazione
    const enriched = filtered.map(st => {
      const priceVal = st.prices[priceKey].prezzo;
      const opp = calculateOpportunity(st, priceVal, natAvg);
      return { ...st, priceVal, opp };
    });

    if (currentSort === 'distance' && userCoords) {
      enriched.sort((a, b) => a.distanceKm - b.distanceKm);
    } else if (currentSort === 'opportunity' && userCoords) {
      enriched.sort((a, b) => b.opp.netSavings - a.opp.netSavings);
    } else {
      enriched.sort((a, b) => a.priceVal - b.priceVal);
    }

    resultsCount.textContent = Math.min(enriched.length, 10);
    
    if (userCoords) {
      if (userCoords.isIp) {
        resultsSubtitle.textContent = `I 10 distributori più convenienti vicino a te (Zona ${userCoords.cityName || 'IP'}, raggio ${selectedRadius} km). Clicca "Vicino a Te" per la precisione GPS al civico.`;
      } else {
        resultsSubtitle.textContent = `I 10 distributori più convenienti nel raggio di ${selectedRadius} km dalla tua posizione GPS (calcolo su pieno di ${userLiters}L).`;
      }
    } else if (provName) {
      resultsSubtitle.textContent = `I 10 distributori più convenienti nella provincia di ${provName}`;
    } else {
      resultsSubtitle.textContent = "I 10 distributori con il miglior prezzo in Italia. Usa il pulsante \"Vicino a Te\" o seleziona una provincia per calcolare il risparmio vicino a te.";
    }

    // Aggiorna Mappa Leaflet
    if (enriched.length > 0) {
      const mapCenterLat = userCoords ? userCoords.lat : (provName ? enriched[0].lat : 42.2);
      const mapCenterLng = userCoords ? userCoords.lng : (provName ? enriched[0].lng : 12.8);
      const mapZoom = userCoords ? (selectedRadius <= 1.5 ? 15 : (selectedRadius <= 5 ? 13 : (selectedRadius <= 10 ? 12 : 11))) : (provName ? 10 : 6);
      initOrUpdateMap(mapCenterLat, mapCenterLng, mapZoom);

      if (markersLayer) {
        markersLayer.clearLayers();

        // Marker utente
        if (userCoords && window.L) {
          const userIcon = window.L.divIcon({
            className: 'custom-user-marker',
            html: userCoords.isIp
              ? '<div style="width:16px; height:16px; background:#0ea5e9; border:3px solid #ffffff; border-radius:50%; box-shadow:0 0 10px #0ea5e9;"></div>'
              : '<div style="width:16px; height:16px; background:#10b981; border:3px solid #ffffff; border-radius:50%; box-shadow:0 0 12px #10b981;"></div>',
            iconSize: [16, 16],
          });

          const popupContent = userCoords.isIp
            ? `<div style="font-family:system-ui; padding:3px;">
                 <div style="font-size:12px; font-weight:800; color:#0ea5e9;">📍 Posizione Stimata da IP</div>
                 <div style="font-size:11px; margin-top:2px;">Zona: <strong>${userCoords.cityName || 'Rilevata'}</strong></div>
                 <div style="font-size:10px; color:#71717a; margin-top:4px;">Clicca "Vicino a Te" per la massima precisione GPS al civico</div>
               </div>`
            : `<div style="font-family:system-ui; padding:3px;">
                 <div style="font-size:12px; font-weight:800; color:#10b981;">🎯 La tua posizione GPS esatta</div>
               </div>`;

          window.L.marker([userCoords.lat, userCoords.lng], { icon: userIcon })
            .bindPopup(popupContent)
            .addTo(markersLayer);
        }

        // Marker stazioni (Top 10)
        enriched.slice(0, 10).forEach((st, idx) => {
          if (!st.lat || !st.lng || !window.L) return;
          const isCheapest = idx === 0;
          const iconClass = isCheapest ? 'pb-marker-cheapest' : 'pb-marker-standard';
          const icon = window.L.divIcon({
            className: iconClass,
            html: `<div style="font-size:10px; padding:2px 5px; text-align:center;">€${st.priceVal.toFixed(2)}</div>`,
            iconSize: [46, 20],
          });

          const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${st.lat},${st.lng}`;

          const marker = window.L.marker([st.lat, st.lng], { icon })
            .bindPopup(`
              <div style="font-family:system-ui; padding:2px;">
                <div style="font-size:11px; font-weight:800; color:#10b981;">${st.brand}</div>
                <div style="font-size:13px; font-weight:bold;">${st.nome || st.brand}</div>
                <div style="font-size:11px; opacity:0.8;">${st.indirizzo} - ${st.comune}</div>
                <div style="font-size:16px; font-weight:900; color:#10b981; margin:4px 0;">€ ${st.priceVal.toFixed(3)}/L</div>
                ${st.distanceKm !== null ? `<div style="font-size:10px; margin-bottom:6px;">📍 ${st.distanceKm} km da te</div>` : ''}
                <a href="${mapsUrl}" target="_blank" style="display:inline-block; font-size:11px; font-weight:bold; background:#10b981; color:#09090b; padding:4px 10px; border-radius:6px; text-decoration:none;">Naviga qui →</a>
              </div>
            `);
          markersLayer.addLayer(marker);
        });

        // Auto-adatta lo zoom (fitBounds) per inquadrare TUTTI i 10 marker + utente nello schermo
        if (window.L && leafletMap) {
          const points = [];
          if (userCoords && userCoords.lat && userCoords.lng) {
            points.push([userCoords.lat, userCoords.lng]);
          }
          enriched.slice(0, 10).forEach(st => {
            if (st.lat && st.lng) points.push([st.lat, st.lng]);
          });
          if (points.length > 0) {
            const bounds = window.L.latLngBounds(points);
            leafletMap.fitBounds(bounds, { padding: [35, 35], maxZoom: selectedRadius <= 1.5 ? 16 : 14 });
          }
        }
      }
    }

    if (enriched.length === 0) {
      stationsList.innerHTML = `
        <div class="p-8 text-center bg-zinc-100 dark:bg-zinc-950 rounded-2xl border border-zinc-200 dark:border-zinc-800">
          <p class="text-zinc-600 dark:text-zinc-400 text-sm">Nessun distributore con <strong>${selectedFuel.toUpperCase()} (${selectedService})</strong> trovato nel raggio di ${selectedRadius} km.</p>
          <p class="text-xs text-zinc-500 mt-2">Prova ad aumentare il raggio a 25 km o seleziona un altro carburante.</p>
        </div>
      `;
      return;
    }

    const topStations = enriched.slice(0, 10);

    stationsList.innerHTML = topStations.map((st, idx) => {
      const isTop1 = idx === 0;
      const opp = st.opp;

      const mapsUrl = st.lat && st.lng
        ? `https://www.google.com/maps/dir/?api=1&destination=${st.lat},${st.lng}`
        : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent((st.nome || st.brand) + ' ' + st.indirizzo + ' ' + st.comune)}`;

      return `
        <div class="p-4 sm:p-5 rounded-2xl border ${isTop1 ? 'border-emerald-500/50 bg-emerald-50/50 dark:bg-emerald-950/20 shadow-lg shadow-emerald-500/10' : 'border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-950/60 hover:border-zinc-300 dark:hover:border-zinc-700'} transition-all flex flex-col gap-3">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-1 flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider ${st.brand === 'Pompa Bianca' ? 'bg-amber-500/20 text-amber-600 dark:text-amber-300 border border-amber-500/30' : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-300'}">
                  ${st.brand}
                </span>
                ${isTop1 ? '<span class="px-2 py-0.5 rounded-md text-[11px] font-black uppercase bg-emerald-500 text-zinc-950">🏆 Più Economico</span>' : ''}
                ${st.distanceKm !== null ? `<span class="text-xs text-zinc-500 dark:text-zinc-400 font-semibold">📍 ${st.distanceKm} km da te ${userCoords && userCoords.isIp ? '<span class="text-[10px] text-zinc-400 font-normal">(stima IP)</span>' : ''}</span>` : ''}
              </div>

              <h4 class="font-bold text-zinc-900 dark:text-white text-base leading-snug truncate">
                ${st.nome || st.brand}
              </h4>

              <p class="text-xs text-zinc-500 dark:text-zinc-400 truncate">
                ${st.indirizzo} — <strong class="text-zinc-700 dark:text-zinc-300">${st.comune}</strong>
              </p>
            </div>

            <div class="flex items-center sm:flex-col sm:items-end justify-between border-t sm:border-t-0 border-zinc-100 dark:border-zinc-800/60 pt-2 sm:pt-0 gap-2 shrink-0">
              <div class="text-left sm:text-right">
                <div class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400 tracking-tight">
                  € ${st.priceVal.toFixed(3)}
                </div>
                <div class="text-[10px] text-zinc-400 font-medium">al litro (${selectedService})</div>
              </div>

              <a
                href="${mapsUrl}"
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-900 dark:bg-zinc-100 hover:bg-zinc-800 dark:hover:bg-white text-white dark:text-zinc-950 transition-colors shadow-sm flex items-center gap-1.5"
              >
                <svg class="w-4 h-4 text-emerald-400 dark:text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z"/>
                </svg>
                <span>Portami qui</span>
              </a>
            </div>
          </div>

          <!-- Prezzo Opportunità & Costo Spostamento Breakdown -->
          ${opp.hasGeo ? `
            <div class="pt-2.5 border-t border-zinc-100 dark:border-zinc-800/60 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold ${opp.badgeClass}">
                  ${opp.verdict}
                </span>
              </div>
              <div class="text-[11px] text-zinc-400 flex items-center gap-3">
                <span>Costo viaggio A/R: <strong>€ ${opp.tripCost.toFixed(2)}</strong></span>
                <span>Tempo st.: <strong>~${opp.tripMinutes} min</strong></span>
              </div>
            </div>
          ` : ''}

        </div>
      `;
    }).join('');

    if (hasSearched) {
      resultsContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function setLoading(isLoading) {
    if (isLoading) {
      btnGeolocate.disabled = true;
      btnText.textContent = 'Ricerca in corso...';
      spinner.classList.remove('hidden');
    } else {
      btnGeolocate.disabled = false;
      btnText.textContent = userCoords && userCoords.isIp ? `📍 Vicino a Te (${userCoords.cityName || 'Zona IP'})` : '📍 Vicino a Te';
      spinner.classList.add('hidden');
    }
  }

  function showStatus(message, type = 'info') {
    statusBox.classList.remove('hidden', 'bg-emerald-950/40', 'border-emerald-500/40', 'text-emerald-300', 'bg-rose-950/40', 'border-rose-500/40', 'text-rose-300');
    if (type === 'error') {
      statusBox.classList.add('bg-rose-950/40', 'border', 'border-rose-500/40', 'text-rose-300');
    } else {
      statusBox.classList.add('bg-emerald-950/40', 'border', 'border-emerald-500/40', 'text-emerald-300');
    }
    statusBox.textContent = message;
  }

  // Avvio automatico immediato mappa con i prezzi migliori d'Italia e autogeolocalizzazione IP
  function bootMap() {
    if (typeof window.L === 'undefined') {
      setTimeout(bootMap, 60);
      return;
    }
    currentStations = (window.__PB_INITIAL_STATIONS || []).map(s => ({
      ...s,
      distanceKm: null,
    }));
    initOrUpdateMap(42.2, 12.8, 6);
    renderResults();
    setTimeout(() => {
      if (leafletMap) leafletMap.invalidateSize();
    }, 250);

    // Esegui immediatamente geolocalizzazione automatica da IP
    autoGeolocateByIp();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootMap);
  } else {
    bootMap();
  }
</script>
