---
import nationalStats from '../data/national-stats.json';

const extractionFormatted = new Date(nationalStats.extractionDate).toLocaleDateString('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<section class="border-y border-zinc-800/80 bg-zinc-900/40 backdrop-blur-sm py-4">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      
      <!-- Indicator tag -->
      <div class="flex items-center gap-2">
        <span class="flex h-2.5 w-2.5 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <div class="text-xs">
          <div class="font-bold text-white flex items-center gap-1.5">
            <span>Medie Nazionali Italia</span>
            <span class="text-[10px] px-1.5 py-0.2 rounded bg-zinc-800 text-zinc-400">Oggi</span>
          </div>
          <div class="text-[11px] text-zinc-400">
            Dati MIMIT al {extractionFormatted} ({nationalStats.totalActiveWithPrices.toLocaleString('it-IT')} impianti)
          </div>
        </div>
      </div>

      <!-- Price Tickers -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-center">
        <!-- Benzina -->
        <div class="px-3.5 py-2 rounded-xl bg-zinc-950/80 border border-zinc-800/80">
          <div class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Benzina Self</div>
          <div class="text-base sm:text-lg font-black text-emerald-400">
            € {nationalStats.averages.benzina_self ? nationalStats.averages.benzina_self.toFixed(3) : '—'}
          </div>
        </div>

        <!-- Diesel -->
        <div class="px-3.5 py-2 rounded-xl bg-zinc-950/80 border border-zinc-800/80">
          <div class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Diesel Self</div>
          <div class="text-base sm:text-lg font-black text-teal-400">
            € {nationalStats.averages.diesel_self ? nationalStats.averages.diesel_self.toFixed(3) : '—'}
          </div>
        </div>

        <!-- GPL -->
        <div class="px-3.5 py-2 rounded-xl bg-zinc-950/80 border border-zinc-800/80">
          <div class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">GPL</div>
          <div class="text-base sm:text-lg font-black text-blue-400">
            € {nationalStats.averages.gpl ? nationalStats.averages.gpl.toFixed(3) : '—'}
          </div>
        </div>

        <!-- Metano -->
        <div class="px-3.5 py-2 rounded-xl bg-zinc-950/80 border border-zinc-800/80">
          <div class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Metano</div>
          <div class="text-base sm:text-lg font-black text-zinc-300">
            € {nationalStats.averages.metano ? nationalStats.averages.metano.toFixed(3) : '—'}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
