---
import Layout from '../layouts/Layout.astro';
import nationalStats from '../data/national-stats.json';
import provincesSummary from '../data/provinces-summary.json';

const extractionFormatted = new Date(nationalStats.extractionDate).toLocaleDateString('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Calcola medie regionali
const regionalAverages = {};
for (const p of provincesSummary) {
  if (!regionalAverages[p.region]) {
    regionalAverages[p.region] = { benzina: [], diesel: [] };
  }
  if (p.avgBenzina) regionalAverages[p.region].benzina.push(p.avgBenzina);
  if (p.avgDiesel) regionalAverages[p.region].diesel.push(p.avgDiesel);
}

const natBenzina = nationalStats.averages.benzina_self || 1.8;

const regionsList = Object.entries(regionalAverages).map(([region, data]) => {
  const avgB = data.benzina.length ? data.benzina.reduce((a, b) => a + b, 0) / data.benzina.length : null;
  const avgD = data.diesel.length ? data.diesel.reduce((a, b) => a + b, 0) / data.diesel.length : null;
  const diff = avgB ? Number(((avgB - natBenzina) * 100).toFixed(1)) : null;
  const diffLabel = diff !== null
    ? (diff <= 0 ? `${diff} cent` : `+${diff} cent`)
    : null;
  return {
    region,
    avgBenzina: avgB ? Number(avgB.toFixed(3)) : null,
    avgDiesel: avgD ? Number(avgD.toFixed(3)) : null,
    diff,
    diffLabel,
  };
}).sort((a, b) => (a.avgBenzina || 99) - (b.avgBenzina || 99));

const title = "Prezzo Benzina e Diesel Oggi in Italia | Osservatorio PrezzoBenza.it";
const description = `Prezzo benzina e diesel oggi in Italia: medie nazionali self e servito, confronto tra tutte le regioni e statistiche ufficiali MIMIT.`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.prezzobenza.it" },
        { "@type": "ListItem", "position": 2, "name": "Osservatorio Prezzi", "item": "https://www.prezzobenza.it/prezzi-oggi" }
      ]
    },
    {
      "@type": "Dataset",
      "name": "Prezzi Carburanti Italia Oggi - Osservatorio MIMIT",
      "description": "Elaborazione statistica ufficiale dei prezzi medi di benzina, diesel, GPL e metano nelle regioni italiane.",
      "url": "https://www.prezzobenza.it/prezzi-oggi",
      "creator": {
        "@type": "Organization",
        "name": "PrezzoBenza.it"
      },
      "temporalCoverage": nationalStats.extractionDate
    }
  ]
};
---

<Layout title={title} description={description} canonical="/prezzi-oggi" structuredData={structuredData}>
  <!-- Breadcrumbs -->
  <div class="border-b border-zinc-200 dark:border-zinc-900 bg-zinc-100/60 dark:bg-zinc-950/60 py-3 transition-colors">
    <div class="max-w-6xl mx-auto px-4 text-xs text-zinc-500 dark:text-zinc-400 flex items-center gap-2">
      <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-zinc-900 dark:text-white font-medium">Osservatorio Prezzi Oggi</span>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-10 space-y-10">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
        📊 Dati Ufficiali MIMIT • {extractionFormatted}
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-zinc-900 dark:text-white tracking-tight">
        Osservatorio Prezzi Carburanti in Italia
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 max-w-2xl leading-relaxed">
        Medie nazionali ed elaborazione per regione dei prezzi di benzina e gasolio comunicati oggi dagli esercenti al Ministero.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-1">
        <div class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Benzina Self</div>
        <div class="text-3xl font-black text-emerald-600 dark:text-emerald-400">
          € {nationalStats.averages.benzina_self?.toFixed(3)}
        </div>
        <div class="text-[10px] text-zinc-500">Media nazionale</div>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-1">
        <div class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Diesel Self</div>
        <div class="text-3xl font-black text-teal-600 dark:text-teal-400">
          € {nationalStats.averages.diesel_self?.toFixed(3)}
        </div>
        <div class="text-[10px] text-zinc-500">Media nazionale</div>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-1">
        <div class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Benzina Servito</div>
        <div class="text-3xl font-black text-zinc-700 dark:text-zinc-300">
          € {nationalStats.averages.benzina_servito?.toFixed(3)}
        </div>
        <div class="text-[10px] text-zinc-500">Media nazionale</div>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-1">
        <div class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">GPL</div>
        <div class="text-3xl font-black text-blue-600 dark:text-blue-400">
          € {nationalStats.averages.gpl?.toFixed(3)}
        </div>
        <div class="text-[10px] text-zinc-500">Media nazionale</div>
      </div>
    </div>

    <!-- Regioni Table -->
    <div class="space-y-4">
      <h2 class="text-xl font-bold text-zinc-900 dark:text-white">Classifica Regioni per Prezzo Medio Benzina</h2>
      <div class="overflow-x-auto rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950/60 shadow-sm">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-100 dark:bg-zinc-900/80 text-zinc-600 dark:text-zinc-400 uppercase text-[10px] tracking-wider border-b border-zinc-200 dark:border-zinc-800">
            <tr>
              <th class="p-3.5">#</th>
              <th class="p-3.5">Regione</th>
              <th class="p-3.5 text-right">Media Benzina</th>
              <th class="p-3.5 text-right">Media Diesel</th>
              <th class="p-3.5 text-right">Scostamento</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
            {regionsList.map((r, i) => (
              <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40 transition-colors">
                <td class="p-3.5 text-zinc-400 font-bold">{i + 1}</td>
                <td class="p-3.5 font-bold text-zinc-900 dark:text-white text-sm">{r.region}</td>
                <td class="p-3.5 text-right font-black text-emerald-600 dark:text-emerald-400 text-sm">
                  {r.avgBenzina ? `€ ${r.avgBenzina.toFixed(3)}` : '—'}
                </td>
                <td class="p-3.5 text-right font-bold text-teal-600 dark:text-teal-400 text-sm">
                  {r.avgDiesel ? `€ ${r.avgDiesel.toFixed(3)}` : '—'}
                </td>
                <td class="p-3.5 text-right font-semibold text-zinc-600 dark:text-zinc-400">
                  {r.diffLabel || '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>
